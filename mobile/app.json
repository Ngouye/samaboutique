{
  "expo": {
    "name": "SamaBoutik",
    "slug": "samaboutik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-font",
      "expo-splash-screen"
    ],
    "scheme": "samaboutik",
    "backgroundColor": "#f7f6f2"
  }
}
